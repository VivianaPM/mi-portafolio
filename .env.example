# .env.example - Plantilla para otros desarrolladores
# ==================================================

# ===== GOOGLE ANALYTICS =====
# Obtén tu ID en: https://analytics.google.com
# Si no quieres analytics, déjalo vacío
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== CONFIGURACIÓN DEL SITIO =====
# URL del sitio en producción (para SEO)
VITE_SITE_URL=https://tu-usuario.github.io/mi-portafolio

# Nombre del sitio
VITE_SITE_NAME="Mi Portafolio Profesional"

# ===== FEATURES TOGGLES =====
# Activar/desactivar funcionalidades
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MAINTENANCE=false

# ===== ENTORNO =====
# development | production | staging
VITE_ENV=development
VITE_DEBUG=true